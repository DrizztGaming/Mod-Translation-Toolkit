<Window x:Class="ModTranslationToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mod Translation Toolkit v1.0 Preview"
        Width="1280" Height="820" MinWidth="1000" MinHeight="650">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="6">
            <StackPanel>
                <TextBlock Text="MOD TRANSLATION TOOLKIT" FontSize="22" FontWeight="Bold" Foreground="#D8B7FF"/>
                <TextBlock Text=".NET v1 Preview • native Windows EXE • dark Mrokar theme" Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="API / Translation" Click="Api_Click"/>
        </DockPanel>

        <TabControl Grid.Row="1" Margin="4">
            <TabItem Header="RimWorld Game"><ContentControl Content="{Binding}" Template="{StaticResource ProfileTemplate}"/></TabItem>
            <TabItem Header="RimWorld Mod"><ContentControl Content="{Binding}" Template="{StaticResource ProfileTemplate}"/></TabItem>
            <TabItem Header="Kenshi Game"><ContentControl Content="{Binding}" Template="{StaticResource ProfileTemplate}"/></TabItem>
            <TabItem Header="Project Zomboid Game"><ContentControl Content="{Binding}" Template="{StaticResource ProfileTemplate}"/></TabItem>
            <TabItem Header="Project Zomboid Mod"><ContentControl Content="{Binding}" Template="{StaticResource ProfileTemplate}"/></TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="8,4">
            <TextBlock Text="{Binding CountText}" FontWeight="SemiBold" Margin="0,0,18,0"/>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}"/>
        </DockPanel>
    </Grid>

    <Window.Resources>
        <DataTemplate x:Key="ProfileTemplate">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Choose folder" Click="ChooseFolder_Click"/>
                        <TextBox Grid.Column="1" x:Name="PathBox" Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}" Margin="8,4"/>
                        <Button Grid.Column="2" Content="Scan" Click="Scan_Click"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="Source:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SourceLanguage" Width="150" SelectedIndex="0">
                        <ComboBoxItem Content="English" Tag="EN"/>
                        <ComboBoxItem Content="Polish" Tag="PL"/>
                    </ComboBox>
                    <TextBlock Text="Target:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="TargetLanguage" Width="150" SelectedIndex="1">
                        <ComboBoxItem Content="English" Tag="EN"/>
                        <ComboBoxItem Content="Polish" Tag="PL"/>
                    </ComboBox>
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="14,0,2,0"/>
                    <ComboBox Width="190" SelectionChanged="Filter_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="All" Tag="All"/>
                        <ComboBoxItem Content="Missing translation" Tag="Missing"/>
                        <ComboBoxItem Content="Translated" Tag="Translated"/>
                        <ComboBoxItem Content="Identical source/target" Tag="Identical"/>
                        <ComboBoxItem Content="Suspicious" Tag="Suspicious"/>
                    </ComboBox>
                    <Button Content="Export CSV" Click="ExportCsv_Click"/>
                    <Button Content="Import CSV" Click="ImportCsv_Click"/>
                </StackPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding EntriesView}" Margin="0,8,0,0"
                          IsReadOnly="False" EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Root" Binding="{Binding Root}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="File" Binding="{Binding File}" Width="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="280" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Translation" Binding="{Binding Translation, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>
    </Window.Resources>
</Window>
