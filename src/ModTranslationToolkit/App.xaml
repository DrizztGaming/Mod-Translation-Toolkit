<Application x:Class="ModTranslationToolkit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#121018"/>
        <SolidColorBrush x:Key="Panel" Color="#1B1723"/>
        <SolidColorBrush x:Key="Panel2" Color="#241E2E"/>
        <SolidColorBrush x:Key="Border" Color="#4A385D"/>
        <SolidColorBrush x:Key="Accent" Color="#7A3FC2"/>
        <SolidColorBrush x:Key="AccentHover" Color="#9355DB"/>
        <SolidColorBrush x:Key="Text" Color="#F2EDF8"/>
        <SolidColorBrush x:Key="Muted" Color="#B9AEC9"/>

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource Bg}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#A06CE2"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2235"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="7"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2235"/>
            <Setter Property="Foreground" Value="#17121F"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowBackground" Value="#211B2A"/>
            <Setter Property="AlternatingRowBackground" Value="#2A2235"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource Bg}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </Application.Resources>
</Application>
